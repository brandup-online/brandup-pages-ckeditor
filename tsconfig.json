{
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "strict": true,
    "module": "esnext",
    "target": "es2019",
    "sourceMap": true,
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}